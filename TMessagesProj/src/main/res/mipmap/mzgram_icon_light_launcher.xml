<?xml version="1.0" encoding="utf-8"?>
<!-- MZGram: own colour variant of the MZGram launcher icon (Light) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#EFE7FD"
                android:endColor="#FFFFFF" />
        </shape>
    </item>
    <item android:drawable="@drawable/mzgram_icon_light_foreground" />
</layer-list>
