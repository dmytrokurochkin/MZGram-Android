<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="mzgram_ghost_mode"
        android:enabled="true"
        android:icon="@drawable/ghost"
        android:shortcutShortLabel="@string/MZGramGhostMode"
        android:shortcutLongLabel="@string/MZGramGhostMode">
        <intent
            android:action="org.telegram.messenger.mzgram.ACTION_TOGGLE_GHOST_MODE"
            android:targetPackage="@string/mzgram_account_type"
            android:targetClass="org.telegram.messenger.mzgram.MZGramShortcutActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="mzgram_scan_qr"
        android:enabled="true"
        android:icon="@drawable/msg_qr_scan"
        android:shortcutShortLabel="@string/MZGramShortcutScanQr"
        android:shortcutLongLabel="@string/MZGramShortcutScanQr">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="@string/mzgram_account_type"
            android:targetClass="org.telegram.ui.LaunchActivity"
            android:data="tg://scanqr" />
    </shortcut>

    <share-target android:targetClass="org.telegram.ui.LaunchActivity">
        <data android:mimeType="*/*" />
        <category android:name="org.telegram.messenger.SHORTCUT_SHARE" />
    </share-target>

    <capability android:name="actions.intent.GET_THING">
        <intent>
            <url-template android:value="tg://search{?query}" />
            <parameter
                android:name="thing.name"
                android:key="query"
                android:required="true" />
        </intent>
        <intent>
            <url-template android:value="tg://search" />
        </intent>
    </capability>
    <capability android:name="actions.intent.CREATE_CALL">
        <intent>
            <url-template android:value="tg://call{?format,name,phone}" />
            <parameter
                android:name="call.callFormat"
                android:key="format" />
            <parameter
                android:name="call.participant.name"
                android:key="name" />
            <parameter
                android:name="call.participant.telephone"
                android:key="phone" />
        </intent>
    </capability>
    <capability android:name="actions.intent.GET_ACCOUNT">
        <intent>
            <url-template android:value="tg://settings" />
        </intent>
    </capability>
    <capability android:name="actions.intent.GET_BARCODE">
        <intent>
            <url-template android:value="tg://scanqr" />
        </intent>
    </capability>
    <capability android:name="actions.intent.GET_CALL">
        <intent>
            <url-template android:value="tg://calllog" />
        </intent>
    </capability>
</shortcuts>